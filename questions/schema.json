{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vetd question pack",
  "type": "object",
  "required": ["domain", "tag", "questions"],
  "additionalProperties": false,
  "properties": {
    "domain": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "tag": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "difficulty", "prompt", "options", "correct", "explanation"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-[0-9]+$" },
          "tags": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
            "description": "Extra tags beyond the file's tag"
          },
          "difficulty": { "enum": ["easy", "medium", "hard"] },
          "prompt": { "type": "string", "minLength": 10, "maxLength": 500 },
          "options": {
            "type": "object",
            "required": ["a", "b", "c", "d"],
            "additionalProperties": false,
            "properties": {
              "a": { "type": "string", "minLength": 1 },
              "b": { "type": "string", "minLength": 1 },
              "c": { "type": "string", "minLength": 1 },
              "d": { "type": "string", "minLength": 1 }
            }
          },
          "correct": { "enum": ["a", "b", "c", "d"] },
          "explanation": { "type": "string", "minLength": 10 },
          "time_limit_seconds": { "type": "integer", "minimum": 10, "maximum": 60, "default": 15 },
          "locale": { "type": "string", "default": "en" },
          "status": { "enum": ["active", "retired"], "default": "active" }
        }
      }
    }
  }
}
