# ── Core ────────────────────────────────────────────────
VETD_MODE=single                # single (self-host) | multi (hosted)
VETD_SECRET_KEY=change-me-openssl-rand-hex-32
# Optional separate key for encrypting stored Google refresh tokens.
# Unset: derived from VETD_SECRET_KEY, so rotating the signing secret also
# wipes stored calendar connections. Set it (openssl rand -hex 32) to rotate
# the two independently — rotating VETD_ENCRYPTION_KEY itself just means
# recruiters reconnect their calendars.
#VETD_ENCRYPTION_KEY=
POSTGRES_PASSWORD=vetd
#VETD_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/vetd   # external postgres: use a database dedicated to Vetd

# ── Object storage (CVs) ────────────────────────────────
VETD_S3_BUCKET=vetd-cvs
VETD_S3_ACCESS_KEY=minioadmin
VETD_S3_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
#VETD_S3_PUBLIC_ENDPOINT_URL=https://uploads.example.com   # candidates upload here; must be publicly reachable.
                                                           # Also baked into the frontend CSP at build time — rebuild
                                                           # the frontend image after changing it.

# ── Email (optional; emails are skipped with a warning if unset)
#VETD_PUBLIC_BASE_URL=https://jobs.example.com   # candidate-facing origin; quiz links in emails use it

# Google sign-in (optional). Create an OAuth web client in Google Cloud Console;
# redirect URI is ${VETD_PUBLIC_BASE_URL}/api/v1/auth/google/callback unless
# VETD_GOOGLE_REDIRECT_URL overrides it.
#VETD_GOOGLE_CLIENT_ID=
#VETD_GOOGLE_CLIENT_SECRET=
#VETD_GOOGLE_REDIRECT_URL=
#VETD_SMTP_HOST=
#VETD_SMTP_PORT=587
#VETD_SMTP_USER=
#VETD_SMTP_PASSWORD=
#VETD_SMTP_STARTTLS=false          # disable for plaintext relays (e.g. local mailhog)
#VETD_EMAIL_FROM=jobs@example.com

# ── Cookies ────────────────────────────────────────────
#VETD_COOKIE_SECURE=true          # enable behind HTTPS in production

# ── Limits ──────────────────────────────────────────────
VETD_CV_MAX_SIZE_MB=10
# Per-IP, per-minute rate limits (Redis-backed; in-memory fallback).
# trust_proxy_headers reads X-Forwarded-For — keep the backend behind a
# trusted proxy in production, or spoofed IPs can dodge the limits.
#VETD_RATE_LIMIT_ENABLED=true
#VETD_TRUST_PROXY_HEADERS=true
#VETD_RATE_LIMIT_AUTH_PER_MINUTE=10
#VETD_RATE_LIMIT_APPLY_PER_MINUTE=5
#VETD_RATE_LIMIT_UPLOAD_PER_MINUTE=10
#VETD_RATE_LIMIT_QUIZ_PER_MINUTE=60
#VETD_RATE_LIMIT_PUBLIC_PER_MINUTE=120

# ── Production hardening checklist (candidate PII lives here — GDPR) ──
# HTTPS everywhere: terminate TLS at your proxy and set VETD_COOKIE_SECURE=true.
#   Quiz/status/interview links are bearer tokens — plain HTTP exposes them.
# SMTP: use a TLS relay (VETD_SMTP_STARTTLS=true, the default) for anything
#   beyond a local dev catcher; candidate names and links transit email.
# MinIO: change VETD_S3_ACCESS_KEY/SECRET_KEY *and* MINIO_ROOT_USER/PASSWORD
#   from the minioadmin defaults, and don't expose ports 9000/9001 publicly —
#   candidates only ever need the presigned-upload host you configured above.
# Backend port 8000: keep it behind your reverse proxy, never internet-facing.
#   VETD_TRUST_PROXY_HEADERS reads X-Forwarded-For; a directly reachable
#   backend lets clients spoof their IP and dodge rate limits.
# Redis: the compose network keeps it internal. Any other topology needs
#   `requirepass` (redis://:password@host:6379/0) — job payloads reference
#   candidate data.
# Storage encryption: the app sets no S3 SSE headers — enable encryption at
#   rest on your storage layer (MinIO KMS/SSE, disk encryption, or a provider
#   that encrypts by default). Same for Postgres volumes.
# Backups × erasure: if you back up the database or the CV bucket, keep the
#   rotation window at or below your configured retention period, and never
#   restore erased candidates — completing the rotation completes the erasure.
