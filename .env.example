# ── Core ────────────────────────────────────────────────
GANEK_MODE=single                # single (self-host) | multi (hosted)
GANEK_EDITION=community          # community | hosted (loads the ee/ plan policy if installed)
GANEK_SECRET_KEY=change-me-openssl-rand-hex-32
# Optional separate key for encrypting stored 2FA secrets and webhook
# signing secrets. Unset: derived from GANEK_SECRET_KEY, so rotating the
# signing secret also invalidates both. Set it (openssl rand -hex 32) to
# rotate the two independently - rotating GANEK_ENCRYPTION_KEY itself means
# users re-enrol their authenticator and webhook endpoints need a new secret.
#GANEK_ENCRYPTION_KEY=
#GANEK_REDIS_URL=redis://localhost:6379/0   # compose sets redis://redis:6379/0; rate limits, quotas and the worker queue
#GANEK_QUESTIONS_DIR=                       # explicit question-bank path; auto-detected (repo questions/ or /srv/questions) when unset
POSTGRES_PASSWORD=ganek
#GANEK_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/ganek   # external postgres: use a database dedicated to Ganek

# ── Object storage (CVs) ────────────────────────────────
#GANEK_S3_ENDPOINT_URL=http://localhost:9000   # compose sets http://minio:9000; the backend-side S3 endpoint
GANEK_S3_BUCKET=ganek-cvs
GANEK_S3_ACCESS_KEY=minioadmin
GANEK_S3_SECRET_KEY=minioadmin
# CV virus scanning (optional): run compose with --profile clamav and set the
# host to "clamav". Unset = CVs are not scanned (the admin says so).
#GANEK_CLAMAV_HOST=clamav
#GANEK_CLAMAV_PORT=3310
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
#GANEK_S3_PUBLIC_ENDPOINT_URL=https://uploads.example.com   # candidates upload here; must be publicly reachable.
                                                           # Also baked into the frontend CSP at build time - rebuild
                                                           # the frontend image after changing it.

# ── Email (optional; emails are skipped with a warning if unset)
#GANEK_PUBLIC_BASE_URL=https://jobs.example.com   # candidate-facing origin; quiz links in emails use it,
                                                 # and the frontend builds sitemap/OG URLs from it
#GANEK_TENANT_DOMAIN=ganek.io      # multi mode only: serve each company's careers pages on
                                   # <slug>.<this domain> (the edge must send *.<domain> to the
                                   # frontend with a wildcard certificate). Unset = /c/<slug>.

# Google sign-in (optional). Create an OAuth web client in Google Cloud Console;
# redirect URI is ${GANEK_PUBLIC_BASE_URL}/api/v1/auth/google/callback unless
# GANEK_GOOGLE_REDIRECT_URL overrides it.
#GANEK_GOOGLE_CLIENT_ID=
#GANEK_GOOGLE_CLIENT_SECRET=
#GANEK_GOOGLE_REDIRECT_URL=

# Generic OpenID Connect sign-in (optional; Keycloak, Authentik, Okta, Entra ID...).
# Register a confidential web client with redirect URI
# ${GANEK_PUBLIC_BASE_URL}/api/v1/auth/oidc/callback (or GANEK_OIDC_REDIRECT_URL).
# Signs in existing accounts and accepts team invites (the IdP must confirm the
# invited email as verified); no signup. A first sign-in links by email only when
# the IdP says the address is verified and its domain is in GANEK_OIDC_EMAIL_DOMAINS.
#GANEK_OIDC_ISSUER=https://idp.example.com/realms/acme
#GANEK_OIDC_CLIENT_ID=
#GANEK_OIDC_CLIENT_SECRET=
#GANEK_OIDC_REDIRECT_URL=
#GANEK_OIDC_DISPLAY_NAME=SSO        # button label: "Continue with <name>"
#GANEK_OIDC_EMAIL_DOMAINS=example.com,example.org
#GANEK_EMAIL_PROVIDER=smtp          # smtp (any relay, below) or mailjet (HTTPS API, EU-hosted;
                                    # its bounce/complaint events feed the suppression list)
#GANEK_MAILJET_API_KEY=             # mailjet only: the REST API key pair from the Mailjet account
#GANEK_MAILJET_SECRET_KEY=
# Proof-of-work challenge (self-hosted ALTCHA, no third party) on signup, apply
# and request-new-link. Off by default; shown only in multi mode.
#GANEK_CAPTCHA_ENABLED=false
#GANEK_CAPTCHA_SECRET=             # HMAC key, any long random string; required when enabled
#GANEK_CAPTCHA_MAX_NUMBER=100000    # proof-of-work ceiling the widget brute-forces (lower = faster on phones)
#GANEK_CAPTCHA_TTL_SECONDS=600      # how long a solved challenge stays valid
#GANEK_SSR_SECRET=                  # optional: when set, a job page load counts as a page view only if
                                    # the frontend's render sent this value along; any long random string,
                                    # the same value on the backend and the frontend. Unset = every load
                                    # that says it is a view counts (advisory counters, decision JP8).
#GANEK_EMAIL_WEBHOOK_SECRET=        # Basic-auth password the provider presents on its bounce/complaint
                                    # webhook (https://ganek:<secret>@host/api/v1/email/webhooks/mailjet);
                                    # unset = webhooks off. Bounced/complained addresses are skipped.
#GANEK_SMTP_HOST=
#GANEK_SMTP_PORT=587
#GANEK_SMTP_USER=
#GANEK_SMTP_PASSWORD=
#GANEK_SMTP_STARTTLS=false          # disable for plaintext relays (e.g. local mailhog)
#GANEK_EMAIL_FROM=jobs@example.com

# ── Logging ────────────────────────────────────────────
# Every backend log line carries the request id, which is also returned as
# the X-Request-ID response header (an inbound X-Request-ID is honoured).
#GANEK_LOG_FORMAT=text             # json = one object per line for log shippers
#GANEK_LOG_LEVEL=INFO
# Optional error reporting to Sentry (or a self-hosted Sentry/GlitchTip).
# Unset = off, nothing leaves the box. Events are scrubbed before sending
# (emails, capability tokens, CV file names, cookies) and carry the request
# id. Setting this makes your Sentry host a processor: list it in your
# records (docs/compliance/self-hosting-gdpr-guide.md).
#GANEK_SENTRY_DSN=
#GANEK_SENTRY_ENVIRONMENT=production
#GANEK_SENTRY_TRACES_SAMPLE_RATE=0  # performance tracing stays off by default

# ── Cookies ────────────────────────────────────────────
#GANEK_COOKIE_SECURE=true          # enable behind HTTPS in production

# ── Limits ──────────────────────────────────────────────
GANEK_CV_MAX_SIZE_MB=10
# Per-IP, per-minute rate limits (Redis-backed; in-memory fallback).
# trust_proxy_headers reads X-Forwarded-For - keep the backend behind a
# trusted proxy in production, or spoofed IPs can dodge the limits.
#GANEK_RATE_LIMIT_ENABLED=true
#GANEK_TRUST_PROXY_HEADERS=true
#GANEK_RATE_LIMIT_AUTH_PER_MINUTE=10
#GANEK_RATE_LIMIT_APPLY_PER_MINUTE=5
#GANEK_RATE_LIMIT_UPLOAD_PER_MINUTE=10
#GANEK_RATE_LIMIT_QUIZ_PER_MINUTE=60
#GANEK_RATE_LIMIT_PUBLIC_PER_MINUTE=120
# Lockout: after max_attempts failed logins or 2FA codes for one account within
# the window, further attempts are refused until the window passes.
#GANEK_LOCKOUT_ENABLED=true
#GANEK_LOCKOUT_MAX_ATTEMPTS=10
#GANEK_LOCKOUT_WINDOW_SECONDS=900
# Quiz timing: answers that arrive up to the grace period after a question's
# deadline still count (network jitter); a quiz link must be started within
# the TTL after it is issued.
#GANEK_QUIZ_NETWORK_GRACE_SECONDS=2
#GANEK_QUIZ_START_TTL_HOURS=24
# Per-tenant abuse guards (0 = off): emails queued per day, application
# attempts per hour (public apply answers 429 past the limit) and jobs
# published at once (409). Counters are Redis-backed with an in-process
# fallback; admins see them on GET /api/v1/company/usage and as a banner
# from 80% of a limit.
#GANEK_QUOTA_EMAILS_PER_DAY=500
#GANEK_QUOTA_APPLICATIONS_PER_HOUR=100
#GANEK_QUOTA_ACTIVE_JOBS=50

# ── Demo workspace ──────────────────────────────────────
# scripts/dev_seed.sh builds the ACME Ganek demo company; the password applies
# to both of its users. For a public demo instance set the slug: the worker
# then deletes and rebuilds that company every night at 04:07 UTC, so visitors
# always find the same workspace. Unset = no reset job.
#GANEK_DEMO_PASSWORD=ganek-demo-1
#GANEK_DEMO_RESET_SLUG=acme
# Demo mode for a public demo: apply stays on, but every submission is stored
# with a fictional name, email and links and the sample CV (nothing a visitor
# types or uploads is kept), nothing is mailed, and password, 2FA, invites,
# user admin and Google sign-in answer 403 so the shared login keeps working
# for the next visitor. Never set this on a real workspace.
#GANEK_DEMO_MODE=false

# ── Operator plane (hosted instances) ───────────────────
# Comma-separated user ids allowed on /api/v1/ops (tenant list, suspend,
# unsuspend, export, plan override, delete). Every call is logged. Empty = the ops routes answer 404 for
# everyone. A suspended tenant's careers pages answer 503 and its users,
# sessions and API keys are refused with the suspension reason.
#GANEK_SUPERADMIN_USER_IDS=

# ── Production hardening checklist (candidate PII lives here - GDPR) ──
# HTTPS everywhere: terminate TLS at your proxy and set GANEK_COOKIE_SECURE=true.
#   Quiz/status/interview links are bearer tokens - plain HTTP exposes them.
# SMTP: use a TLS relay (GANEK_SMTP_STARTTLS=true, the default) for anything
#   beyond a local dev catcher; candidate names and links transit email.
# MinIO: change GANEK_S3_ACCESS_KEY/SECRET_KEY *and* MINIO_ROOT_USER/PASSWORD
#   from the minioadmin defaults. The default compose binds 9000/9001 to
#   127.0.0.1 - keep it that way; candidates only ever need the
#   presigned-upload host you configured above.
# Backend port 8000: keep it behind your reverse proxy, never internet-facing.
#   The default compose binds it to 127.0.0.1 - republish deliberately only
#   behind a proxy. GANEK_TRUST_PROXY_HEADERS reads X-Forwarded-For; a directly
#   reachable backend lets clients spoof their IP and dodge rate limits.
# Redis: the compose network keeps it internal. Any other topology needs
#   `requirepass` (redis://:password@host:6379/0) - job payloads reference
#   candidate data.
# Storage encryption: the app sets no S3 SSE headers - enable encryption at
#   rest on your storage layer (MinIO KMS/SSE, disk encryption, or a provider
#   that encrypts by default). Same for Postgres volumes.
# Backups × erasure: if you back up the database or the CV bucket, keep the
#   rotation window at or below your configured retention period, and never
#   restore erased candidates - completing the rotation completes the erasure.
